#!/bin/sh
# Keeps the private research layer, medical data, weights and secrets out of history.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Refuses, whatever `git add -f` says:
#   1. the private paths (research protocol, organ research, curation notes);
#   2. any staged file carrying the private marker, so a private document that
#      is renamed or pasted into a public one is still caught;
#   3. any staged file that an ignore rule covers: .gitignore lists medical
#      data, archives, weights, secrets and local fonts, and forcing one past
#      it is exactly the mistake this hook exists for;
#   4. images outside docs/figures/png/, where a medical image could hide as a
#      plain .png or .jpg;
#   5. documents outside the public ones (README, CATALOGUE, docs/, each
#      organ module's README.md and DATASETS.md, and each use's README.md, DATA.md and
#      MODEL_CARD.md), so an unmarked curation note cannot slip in under a
#      new name;
#   6. any binary file outside docs/figures/png/, whatever its extension, and
#      any file over 5 MiB. The ignore rules list the weight formats worth
#      naming; this catches the rest, including formats invented later, so no
#      exported model or medical image can arrive under an unknown suffix.
# There is no skip flag. If it blocks something legitimate, that is a
# conversation and an edit to this file, not a --no-verify.

status=0
marker='BODY-ATLAS-''PRIVATE'

paths=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$paths" ] && exit 0

refuse() {
  if [ -n "$2" ]; then
    printf 'pre-commit: %s:\n%s\n' "$1" "$2" >&2
    status=1
  fi
}

refuse "private research layer staged" \
  "$(printf '%s\n' "$paths" | grep -E '(^|/)(RESEARCH-PROTOCOL\.md|thoughtprocess\.md)$|^(research|private)/')"

refuse "file carries the private marker" \
  "$(printf '%s\n' "$paths" | while IFS= read -r f; do
      [ "$f" = ".githooks/pre-commit" ] && continue
      git show ":$f" 2>/dev/null | grep -q "$marker" && printf '%s\n' "$f"
    done)"

refuse "file covered by an ignore rule (data, weights, secrets or fonts) was forced in" \
  "$(printf '%s\n' "$paths" | git check-ignore --no-index --stdin)"

refuse "image outside docs/figures/png/" \
  "$(printf '%s\n' "$paths" | grep -Ei '\.(png|jpe?g|gif|bmp|webp|heic)$' | grep -v '^docs/figures/png/')"

refuse "document outside the public set (README, CATALOGUE, docs/, organ READMEs, DATA.md, MODEL_CARD.md)" \
  "$(printf '%s\n' "$paths" | grep -Ei '\.(md|markdown|txt|rtf|pdf|docx?|odt|pages)$' \
     | grep -Ev '^(README\.md|CATALOGUE\.md|CONTRIBUTING\.md|docs/.+|organs/[^/]+/[^/]+/(README|DATASETS)\.md|organs/[^/]+/[^/]+/[^/]+/(README|DATA|MODEL_CARD)\.md)$')"

# git itself decides what is binary: numstat prints "-" for both counts.
refuse "binary file outside docs/figures/png/" \
  "$(git diff --cached --numstat --diff-filter=ACMR \
     | awk -F'\t' '$1 == "-" && $2 == "-" { print $3 }' \
     | grep -v '^docs/figures/png/')"

refuse "file over 5 MiB" \
  "$(printf '%s\n' "$paths" | while IFS= read -r f; do
      size=$(git cat-file -s "$(git rev-parse ":$f" 2>/dev/null)" 2>/dev/null || echo 0)
      [ "$size" -gt 5242880 ] && printf '%s (%s bytes)\n' "$f" "$size"
    done)"

exit $status
